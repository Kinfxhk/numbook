<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The only network call the app makes is the optional exchange-rate fetch
	     (frankfurter.app). Without this the release build silently loses rates
	     while debug builds keep working. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Open / Save a copy / Export / Print need a user-chosen destination.
	     Without this the sandboxed (Mac App Store) build shows no save panel
	     and every file verb fails silently, while the unsandboxed build works. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
